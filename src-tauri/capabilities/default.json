{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos para la app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "dialog:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "sidecar": "binaries/yt-dlp" },
        { "sidecar": "binaries/ffmpeg" }
      ]
    }
  ]
}
